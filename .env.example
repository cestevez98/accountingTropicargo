# Secreto para firmar las sesiones (mínimo 32 caracteres). Genera uno con: openssl rand -hex 32
AUTH_SECRET=
# Administrador inicial: solo se usa para crear la primera cuenta cuando todavía no hay usuarios.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Vercel Blob (privado). Sin este token los datos se guardan en la carpeta .data/ (solo para desarrollo).
BLOB_READ_WRITE_TOKEN=
